{
  "name": "docdesk-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DocDesk — CampusOS academic document requests (frontend-only demo build)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx scripts/phase4-service-checks.ts && tsx scripts/e2e-scenarios.ts && tsx scripts/request-screen-checks.ts",
    "verify:service": "tsx scripts/phase4-service-checks.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.65.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
