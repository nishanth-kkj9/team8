{
  "name": "docdesk-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DocDesk — CampusOS academic document requests (frontend-only demo build, Phase 6: polish and QA)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort 2>&1 | tee dev.log",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:service": "bun scripts/phase4-service-checks.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "db:push": "echo 'DocDesk Phase 1 is frontend-only; there is no database to push.'"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
